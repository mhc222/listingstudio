# Supabase (project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# fal.ai (phase 3+)
FAL_KEY=

# Public base URL for the deployed app; fal webhooks post to $NEXT_PUBLIC_APP_URL/api/webhook/fal.
# Leave unset (or localhost) in dev — the reconcile poller completes jobs instead.
NEXT_PUBLIC_APP_URL=

# Protects /api/cron/reconcile in prod (Vercel sends it automatically when set)
CRON_SECRET=

# Claude API (interpreter + copywriting, phase 7+)
ANTHROPIC_API_KEY=
# Required only for identity-linked console keys (wrkspc_... id from console
# Settings -> Workspaces); standard workspace keys can leave this blank
ANTHROPIC_WORKSPACE_ID=

# Optional local ComfyUI-format endpoint (phase 3+, wiring is manual)
LOCAL_IMAGING_BASE_URL=
